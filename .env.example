# Password for encrypting your CKB wallet key (data/ckb/key)
FIBER_SECRET_KEY_PASSWORD=change-me

# testnet or mainnet — picks config/testnet.yml or config/mainnet.yml
FIBER_NETWORK=testnet

# Fiber image tag — see https://hub.docker.com/r/nervos/fiber/tags
FIBER_VERSION=0.9.0-rc3

# FiberFlow API port (maps to localhost; RPC stays internal on 8227)
GATEWAY_PORT=3000
