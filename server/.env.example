# Neon PostgreSQL connection string
DATABASE_URL=

# Better Auth — generate with: bunx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Public URL of the API (api subdomain in production)
# Production: BETTER_AUTH_URL=https://api.example.com
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated browser origins allowed for CORS + auth cookies.
# Production: apex site (landing + dashboard) and checkout subdomain.
# CORS_ORIGIN=https://example.com,https://checkout.example.com
CORS_ORIGIN=http://localhost:5173

# Checkout subdomain — used to build invoice payment_url values.
# Production: PAYMENT_APP_URL=https://checkout.example.com
# Local dev (same origin as the frontend): PAYMENT_APP_URL=http://localhost:5173
PAYMENT_APP_URL=http://localhost:5173

# Fiber RPC (set automatically in Docker)
FIBER_RPC_URL=http://127.0.0.1:8227

# mainnet → fibb, testnet → fibt, devnet → fibd
FIBER_NETWORK=testnet

PORT=3000

# Background workers (milliseconds)
INVOICE_POLL_INTERVAL_MS=15000
WEBHOOK_RETRY_INTERVAL_MS=30000
