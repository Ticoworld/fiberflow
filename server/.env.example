# Neon PostgreSQL connection string
DATABASE_URL=

# Better Auth — generate with: bunx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Public URL of this server (used by Better Auth)
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated frontend origins allowed for auth cookies/CORS
CORS_ORIGIN=http://localhost:5173

# Fiber RPC (set automatically in Docker)
FIBER_RPC_URL=http://127.0.0.1:8227

# mainnet → fibb, testnet → fibt, devnet → fibd
FIBER_NETWORK=testnet

PORT=3000
