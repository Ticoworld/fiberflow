# API subdomain — all server requests go here
# Production: VITE_API_URL=https://api.example.com
VITE_API_URL=http://localhost:3000

# Checkout subdomain — payment links sent to customers
# Production: VITE_PAYMENT_APP_URL=https://checkout.example.com
